# Monorepo root ignores.
# frontend-gym-tracker/ has Flutter's own .gitignore for build/ and .dart_tool/.

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets — never commit these. Set real values in the host's env-var UI.
.env
.env.*
# Any *.env, not just dotfiles: an env file exported from Render arrives named after
# the service (gymtracker-api.env) and matched none of the rules above, leaving a live
# database password and SMTP key one `git add -A` from being committed.
*.env
!.env.example
*.pem
*.key
*.keystore
*.jks
key.properties
local.properties

# Java / Spring backend (once scaffolded)
backend-gym-tracker/target/
backend-gym-tracker/.gradle/
backend-gym-tracker/build/
backend-gym-tracker/out/
backend-gym-tracker/.mvn/wrapper/maven-wrapper.jar

# Logs
*.log
