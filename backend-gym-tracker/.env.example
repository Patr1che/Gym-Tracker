# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
# Neon gives you a URL like:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/gymtracker?sslmode=require
# JDBC needs the jdbc: prefix and the credentials moved out into DB_USER/DB_PASSWORD:
DATABASE_URL=jdbc:postgresql://ep-xxx.region.aws.neon.tech/gymtracker?sslmode=require
DB_USER=
DB_PASSWORD=

# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Exact origins only - "*" is rejected once the API sends an Authorization header.
CORS_ORIGINS=http://localhost:5555

# Rate limiting on /api/v1/auth/**, which is necessarily open to the internet. All four
# have working defaults, so leave them unset unless you are tuning or debugging.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_REGISTRATIONS_PER_HOUR=5
# RATE_LIMIT_MAX_TRACKED_CLIENTS=10000
